# Copy this file to .env and adjust as needed for local development.
# .env is gitignored — docker-compose.yml sets these directly for containers.

# SQLite database path.
# DB_PATH=bottlebot.db

# Set to true/1/yes to record Dan Murphy's member pricing as price_aud
# (non-member price stored in was_price_aud). Default: false (non-member).
DANMURPHYS_MEMBER=false

# Notification secrets (Phase 2) — never commit real values.
# Discord webhook, in apprise's native format: discord://<webhook_id>/<webhook_token>
# (take the id/token pair from the webhook URL Discord gives you)
BOTTLEBOT_DISCORD_WEBHOOK_URL=

# Optional extra apprise target, e.g. ntfy://ntfy.sh/bottlebot-deals
BOTTLEBOT_NTFY_URL=

# BWS internal API key (Phase 3) — extract from the Network tab on bws.com.au,
# requests to api.bws.com.au. Changes infrequently. See src/scrapers/bws.py.
BOTTLEBOT_BWS_SUBSCRIPTION_KEY=

# Local path to a greentechhub-ui checkout, used only when building the
# Docker image (see Dockerfile/docker-compose.yml). Safe to leave unset —
# defaults to ../greentechhub-ui. Remove once greentechhub-ui ships pinned
# releases and requirements.txt points at a git tag instead.
GREENTECHHUB_UI_PATH=../greentechhub-ui
