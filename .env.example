# Copy this file to .env and adjust as needed for local development.
# .env is gitignored — docker-compose.yml sets these directly for containers.

# SQLite database path.
# DB_PATH=bottlebot.db

# Set to true/1/yes to record Dan Murphy's member pricing as price_aud
# (non-member price stored in was_price_aud). Default: false (non-member).
DANMURPHYS_MEMBER=false
